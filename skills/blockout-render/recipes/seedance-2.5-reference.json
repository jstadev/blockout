        0
      ],
      "model.reference_images.image_2": [
        "4",
        0
      ],
      "model.reference_videos.video_1": [
        "rv_mute",
        0
      ],
      "model.reference_audios.audio_1": [
        "9",
        0
      ]
    },
    "class_type": "ByteDance2ReferenceNodeV2",
    "_meta": {
      "title": "ByteDance Seedance 2.5 Reference to Video"
    }
